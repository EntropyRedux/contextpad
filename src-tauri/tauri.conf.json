{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextPad",
  "version": "1.10.0",
  "identifier": "com.contextpad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ContextPad",
        "width": 1000,
        "height": 650,
        "minWidth": 500,
        "minHeight": 400,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}